+// Only observed property opcodes establish direct JS provenance. A tracked API
+// owns the access only when its entry frame is reached before a younger JS frame.
+struct PPTracePropertyAccessOrigin {
+    const char *origin;
+    const char *contextRole;
+};
+
+static PPTracePropertyAccessOrigin PPTraceDirectPropertyOrigin(JSThread *thread, const PPTracePropertyContext *context)
+{
+    const char *role = context != nullptr ? "unknown" : "none";
+    FrameIterator it(const_cast<JSTaggedType *>(thread->GetCurrentFrame()), thread);
+    for (; !it.Done(); it.Advance<GCVisitedFlag::HYBRID_STACK>()) {
+        if (context != nullptr && context->entryFrame == it.GetSp()) {
+            return {context->origin, "direct"};
+        }
+        if (!it.IsJSFrame()) {
+            continue;
+        }
+        auto *method = it.CheckAndGetMethod();
+        if (method == nullptr) {
+            continue;
+        }
+        role = context != nullptr ? "ancestor" : "none";
+        if (method->IsNativeWithCallField()) {
+            return {"native-frame", role};
+        }
+        auto type = it.GetFrameType();
+        if (type != FrameType::ASM_INTERPRETER_FRAME && type != FrameType::INTERPRETER_FRAME &&
+            type != FrameType::INTERPRETER_CONSTRUCTOR_FRAME && type != FrameType::INTERPRETER_FAST_NEW_FRAME) {
+            return {"unknown", role};
+        }
+        uint32_t offset = it.GetBytecodeOffset();
+        if (offset >= method->GetCodeSize(thread)) {
+            return {"unknown", role};
+        }
+        BytecodeInstruction instruction(method->GetBytecodeArray() + offset);
+        switch (instruction.GetOpcode()) {
+            case EcmaOpcode::LDOBJBYNAME_IMM8_ID16:
+            case EcmaOpcode::LDOBJBYNAME_IMM16_ID16:
+            case EcmaOpcode::LDOBJBYVALUE_IMM8_V8:
+            case EcmaOpcode::LDOBJBYVALUE_IMM16_V8:
+            case EcmaOpcode::LDTHISBYNAME_IMM8_ID16:
+            case EcmaOpcode::LDTHISBYNAME_IMM16_ID16:
+            case EcmaOpcode::LDTHISBYVALUE_IMM8:
+            case EcmaOpcode::LDTHISBYVALUE_IMM16:
+            case EcmaOpcode::ISIN_IMM8_V8:
+                return {"js-bytecode", role};
+            default:
+                return {"unknown", role};
+        }
+    }
+    return {"unknown", role};
+}
+
+struct PPTracePropertyOriginInfo {
+    std::string fields;
+    bool inNative;
+    bool inJs;
+};
+
+static PPTracePropertyOriginInfo PPTraceResolvePropertyOrigin(JSThread *thread)
+{
+    const PPTracePropertyContext *selected = nullptr;
+    const char *module = "-";
+    for (auto *ctx = g_pptracePropertyContext; ctx != nullptr; ctx = ctx->previous) {
+        if (ctx->vm != thread->GetEcmaVM()) {
+            continue;
+        }
+        if (std::string(module) == "-" && std::string(ctx->origin) == "native-callback" &&
+            std::string(ctx->module) != "-") {
+            module = ctx->module;
+        }
+        // Prefer N-API over its Ark wrapper only at the same frame boundary.
+        // An outer API must not replace a new API entered from reentrant JS.
+        if (selected == nullptr || (std::string(selected->origin) == "ark-api" &&
+            std::string(ctx->origin) == "napi" && selected->entryFrame == ctx->entryFrame)) {
+            selected = ctx;
+        }
+    }
+    const auto direct = PPTraceDirectPropertyOrigin(thread, selected);
+    const char *api = selected != nullptr ? selected->api : "-";
+    const char *nativeContext = selected != nullptr ? selected->origin : "none";
+    std::string origin = direct.origin;
+    bool inNative = origin == "napi" || origin == "ark-api" ||
+        origin == "native-callback" || origin == "native-frame";
+    return {std::string(" originVersion=2 origin=") + direct.origin + " nativeApi=" + api +
+        " nativeModule=" + PPTraceSanitizeForOneLine(module) + " nativeContext=" + nativeContext +
+        " nativeContextRole=" + direct.contextRole, inNative, origin == "js-bytecode"};
+}
+
+static std::string PPTracePropertyOriginFields(JSThread *thread)
+{
+    return PPTraceResolvePropertyOrigin(thread).fields;
+}
+
+static bool PPTraceShouldSkipObservedFrame(const std::vector<JsFrameInfo> &frames,
+    const PPTracePropertyOriginInfo &origin)
+{
+    if (frames.empty()) {
+        return false;
+    }
+    // An ancestor callback is not proof of a direct native read. Unknown
+    // provenance remains available for offline review rather than being lost.
+    return origin.inJs && PPTraceIsTestHarnessSourceFile(frames.front().fileName);
+}
+
+static void PPTraceTranslateTopFrameSourceMap(JSThread *thread, std::vector<JsFrameInfo> &frames)
+{
+    if (frames.empty()) {
+        return;
+    }
+    auto &frame = frames.front();
+    size_t sep = frame.pos.find(':');
+    if (sep == std::string::npos) {
+        return;
+    }
+    auto sourceMapCb = thread->GetEcmaVM()->GetSourceMapTranslateCallback();
+    if (sourceMapCb == nullptr || frame.fileName.empty()) {
+        return;
+    }
+    int line = std::stoi(frame.pos.substr(0, sep));
+    int column = std::stoi(frame.pos.substr(sep + 1));
+    sourceMapCb(frame.fileName, line, column, frame.packageName);
+}
