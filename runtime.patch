+    size_t left = 0;
+    size_t right = sizeof(observedKeys) / sizeof(observedKeys[0]);
+    while (left < right) {
+        const size_t mid = left + (right - left) / 2;
+        const int comparison = key.compare(observedKeys[mid]);
