+        g_pptraceNativeModuleContext.requestModule = requestName;
+        g_pptraceNativeModuleContext.nativeModule = module && module->name ? module->name : requestName;
+        g_pptraceNativeModuleContext.soPath = module && module->systemFilePath ? module->systemFilePath : "";
+    }
+
+    ~PPTraceNativeModuleScope()
+    {
+        g_pptraceNativeModuleContext = old_;
+    }
+
+private:
+    PPTraceNativeModuleContext old_;
+};
