+bool PPTraceShouldCutFastPathForInstrumentation(JSThread *thread)
+{
+    if (thread == nullptr || thread->GetEcmaVM() == nullptr) {
+        return false;
+    }
+    if (g_pptracePPSinkContext.active) {
+        return true;
+    }
+    auto bundleName = thread->GetEcmaVM()->GetBundleName();
+    if (StartsWithAnyActsBundlePrefix(bundleName.c_str())) {
+        return true;
+    }
+    // During the earliest Ability callbacks the VM bundle name may not have
+    // been published yet.  The workflow sets the phase before launching the
+    // app, so use that phase only for this empty-name bootstrap window.  This
+    // closes the early GET/HAS gap without globally slowing unrelated apps
+    // that already have a non-empty, non-test bundle name.
+    return bundleName.empty() && PPTraceGetPPPhase() != PPTracePPPhase::OFF;
+}
