+static std::string PPTraceFindPath(const PPTracePPSinkContext &ctx, uintptr_t tag)
+{
+    for (uint32_t i = 0; i < ctx.pathCount; i++) {
+        if (ctx.paths[i].tag == tag) {
+            return ctx.paths[i].path;
+        }
+    }
+    return "";
+}
+
+static void PPTraceRememberPath(PPTracePPSinkContext &ctx, uintptr_t tag, const std::string &path)
+{
+    if (tag == 0 || path.empty()) {
+        return;
+    }
+    for (uint32_t i = 0; i < ctx.pathCount; i++) {
+        if (ctx.paths[i].tag == tag) {
+            return;
+        }
+    }
+    if (ctx.pathCount < PPTrace_MAX_PPSINK_PATHS) {
+        ctx.paths[ctx.pathCount].tag = tag;
+        ctx.paths[ctx.pathCount].path = path;
+        ctx.pathCount++;
+    }
+}
+
+static std::string PPTraceBuildArgPath(PPTracePPSinkContext &ctx, uintptr_t receiverTag, const std::string &key)
+{
+    std::string base = PPTraceFindPath(ctx, receiverTag);
+    if (base.empty()) {
+        base = "<receiver>";
+    }
+    return base + "." + key;
+}
