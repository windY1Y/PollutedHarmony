+constexpr uint32_t PPTrace_MAX_PPSINK_ARGS = 8;
+constexpr uint32_t PPTrace_MAX_PPSINK_STACK = 16;
+constexpr uint32_t PPTrace_MAX_PPSINK_PATHS = 128;
+constexpr uint32_t PPTrace_MAX_PPSINK_JS_STACK_FRAMES = 32;
+
+struct PPTracePathEntry {
+    uintptr_t tag = 0;
