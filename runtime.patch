+
+static std::string PPTraceGetTaggedPropertyKeyString(JSThread *thread, JSTaggedValue key)
+{
+    if (key.IsString()) {
+        return EcmaStringAccessor(key).ToStdString(thread);
+    }
+    if (key.IsInt()) {
+        return std::to_string(key.GetInt());
+    }
+    if (!key.IsSpecial() && key.IsDouble()) {
+        return std::to_string(key.GetDouble());
+    }
+    if (key.IsSymbol()) {
+        JSTaggedValue description = JSSymbol::Cast(key.GetTaggedObject())->GetDescription(thread);
+        if (description.IsString()) {
+            return "Symbol(" + EcmaStringAccessor(description).ToStdString(thread) + ")";
+        }
+        return "Symbol()";
+    }
+    return "";
+}
+
+static std::string PPTraceGetPropertyKeyString(JSThread *thread, ObjectOperator *op)
+{
+    if (op->IsElement()) {
+        return std::to_string(op->GetElementIndex());
+    }
+    return PPTraceGetTaggedPropertyKeyString(thread, op->GetKey().GetTaggedValue());
+}
