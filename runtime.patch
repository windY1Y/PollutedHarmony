+static void PPTraceMaybeLogObservedPropType(JSThread *thread,
+    ObjectOperator *op,
+    const std::string &type,
+    const std::string &kind,
+    JSTaggedValue value)
+{
+    if (!PPTracePPPhaseIsType()) {
+        return;
+    }
+
+    const auto &ctx = g_pptracePPSinkContext;
+    std::string key = PPTraceGetPropertyKeyString(thread, op);
+    if (key.empty() || PPTraceIsIgnoredPPProperty(key)) {
+        return;
+    }
+
+    if (!PPTraceShouldObservePropTypeKey(key)) {
+        return;
+    }
+
+    const auto origin = PPTraceResolvePropertyOrigin(thread);
+    // Keep the old context-based observation coverage, but do not use it as
+    // evidence of native provenance. Direct N-API reads need no outer callback.
+    if (!ctx.active && !origin.inNative && !op->IsOnPrototype()) {
+        return;
+    }
+    auto frames = JsStackInfo::BuildJsStackInfo(thread, true);
+    if (PPTraceShouldSkipObservedFrame(frames, origin)) {
+        return;
+    }
+    PPTraceTranslateTopFrameSourceMap(thread, frames);
+
+    std::string jsFunction;
+    std::string jsFile;
+    std::string jsPos;
+    std::string jsPackage;
+    if (!frames.empty()) {
+        auto frame = frames.front();
+        jsFunction = frame.functionName;
+        jsFile = frame.fileName;
+        jsPos = frame.pos;
+        jsPackage = frame.packageName;
+    }
+
+    JSHandle<JSTaggedValue> receiver = op->GetReceiver();
+    JSHandle<JSTaggedValue> holder = op->GetHolder();
+
+    LOG_FULL(INFO) << "[pptrace][prop-type-" << type << "]"
+        << " key=[" << key << "]"
+        << " found=1"
+        << " source=" << (op->IsOnPrototype() ? "prototype" : "own")
+        << " kind=" << kind
+        << " valueType=" << PPTraceValueTypeString(thread, value)
+        << " receiverType=" << PPTraceValueTypeString(thread, receiver.GetTaggedValue())
+        << " holderType=" << PPTraceValueTypeString(thread, holder.GetTaggedValue())
+        << " inNative=" << (origin.inNative ? "1" : "0")
+        << " inNativeContext=" << (ctx.active ? "1" : "0")
+        << origin.fields
+        << " callbackFunction=" << PPTraceOrUnknownLocal(ctx.functionName)
+        << " module=" << PPTraceOrUnknownLocal(ctx.nativeModule)
+        << " requestModule=" << PPTraceOrUnknownLocal(ctx.requestModule)
+        << " function=" << jsFunction
+        << " file=" << jsFile
+        << " pos=" << jsPos
+        << " package=" << jsPackage;
+}
