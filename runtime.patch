+static std::string PPTraceValueTypeString([[maybe_unused]] JSThread *thread, JSTaggedValue value)
+{
+    if (value.IsHole()) {
+        return "hole";
+    }
+    if (value.IsUndefined()) {
+        return "undefined";
+    }
+    if (value.IsNull()) {
+        return "null";
+    }
+    if (value.IsBoolean()) {
+        return "boolean";
+    }
+    if (value.IsInt()) {
+        return "int";
+    }
+    if (value.IsDouble()) {
+        return "double";
+    }
+    if (value.IsBigInt()) {
+        return "bigint";
+    }
+    if (value.IsString()) {
+        return "string";
+    }
+    if (value.IsSymbol()) {
+        return "symbol";
+    }
+    if (value.IsJSProxy()) {
+        return "proxy";
+    }
+    if (value.IsJSArray()) {
+        return "array";
+    }
+    if (value.IsJSTypedArray()) {
+        return "typedarray";
+    }
+    if (value.IsArrayBuffer()) {
+        return "arraybuffer";
+    }
+    if (value.IsSharedArrayBuffer()) {
+        return "sharedarraybuffer";
+    }
+    if (value.IsJSFunction()) {
+        return "function";
+    }
+    if (value.IsCallable()) {
+        return "callable";
+    }
+    if (value.IsJSMap()) {
+        return "map";
+    }
+    if (value.IsJSSet()) {
+        return "set";
+    }
+    if (value.IsJSRegExp()) {
+        return "regexp";
+    }
+    if (value.IsDate()) {
+        return "date";
+    }
+    if (value.IsECMAObject()) {
+        return "object";
+    }
+    if (value.IsTaggedArray()) {
+        return "taggedarray";
+    }
+    if (value.IsJSNativePointer()) {
+        return "nativepointer";
+    }
+    return "other";
