+#define PPTrace_PUBLIC_HOOK __attribute__((visibility("default"), used))
+
+static thread_local const PPTracePropertyContext *g_pptracePropertyContext = nullptr;
+
+extern "C" PPTrace_PUBLIC_HOOK const PPTracePropertyContext *PPTraceExchangePropertyContext(const PPTracePropertyContext *context, bool entering)
+{
+    if (entering && context != nullptr && context->vm != nullptr) {
+        context->entryFrame = static_cast<const EcmaVM *>(context->vm)->GetJSThread()->GetCurrentFrame();
+    }
+    const auto *previous = g_pptracePropertyContext;
+    g_pptracePropertyContext = context;
+    return previous;
+}
+
