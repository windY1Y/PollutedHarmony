+using PPTraceEnterPPSinkContextFunc = void (*)(const char *,
+    const char *, const char *, const char *, const char *,
+    const char *, uint32_t, const uintptr_t *, uint32_t);
+using PPTraceLeavePPSinkContextFunc = void (*)();
+
+static uintptr_t PPTraceGetLocalRawData(panda::Local<panda::JSValueRef> value)
+{
+    if (value.IsEmpty() || *value == nullptr) {
+        return 0;
+    }
+    auto raw = *reinterpret_cast<panda::JSTaggedType *>(*value);
+    return static_cast<uintptr_t>(raw);
+}
+
+static void *PPTraceResolveSymbolFromLoadedLibs(const char *symbol)
+{
+    dlerror();
+    void *fn = dlsym(RTLD_DEFAULT, symbol);
+    const char *defaultErr = dlerror();
+    if (fn != nullptr) {
+        return fn;
+    }
+
+    constexpr const char *PPTrace_RUNTIME_LIBS[] = {
+        "libark_jsruntime.so",
+        "libark_jsruntime.z.so",
+        "libark_jsruntime_debug.so",
+        "libark_jsruntime_debug.z.so",
+        "libark_jsruntime_public.so",
+        "libark_jsruntime_public.z.so",
+        "libark_ecma_debugger.so",
+        "libark_ecma_debugger.z.so",
+    };
+
+    for (const char *lib : PPTrace_RUNTIME_LIBS) {
+        dlerror();
+        void *handle = dlopen(lib, RTLD_NOW | RTLD_NOLOAD | RTLD_GLOBAL);
+        const char *openErr = dlerror();
+        (void)openErr;
+        if (handle == nullptr) {
+            continue;
+        }
+
+        dlerror();
+        fn = dlsym(handle, symbol);
+        const char *symErr = dlerror();
+        (void)symErr;
+        if (fn != nullptr) {
+            return fn;
+        }
+    }
+
+    (void)defaultErr;
+    return nullptr;
+}
+
+static PPTraceEnterPPSinkContextFunc PPTraceResolveEnterPPSinkContext()
+{
+    static PPTraceEnterPPSinkContextFunc fn = nullptr;
+    if (fn == nullptr) {
+        fn = reinterpret_cast<PPTraceEnterPPSinkContextFunc>(
+            PPTraceResolveSymbolFromLoadedLibs("PPTraceEnterPPSinkContext"));
+    }
+    return fn;
+}
+
+static PPTraceLeavePPSinkContextFunc PPTraceResolveLeavePPSinkContext()
+{
+    static PPTraceLeavePPSinkContextFunc fn = nullptr;
+    if (fn == nullptr) {
+        fn = reinterpret_cast<PPTraceLeavePPSinkContextFunc>(
+            PPTraceResolveSymbolFromLoadedLibs("PPTraceLeavePPSinkContext"));
+    }
+    return fn;
+}
+
+static bool PPTraceContains(const std::string &value, const char *needle)
+{
+    return value.find(needle) != std::string::npos;
+}
+
+static bool PPTraceIsIgnoredNativeModule(const std::string &pptraceModule,
+    const std::string &pptraceRequest,
+    const std::string &pptraceSo,
+    const std::string &pptraceExport,
+    const std::string &funcName)
+{
+    const char *ignored[] = {
+        "@ohos/hypium",
+        "hypium",
+        "ohosTest",
+        "hilog",
+        "console"
+    };
+    for (const char *token : ignored) {
+        if (PPTraceContains(pptraceModule, token) ||
+            PPTraceContains(pptraceRequest, token) ||
+            PPTraceContains(pptraceSo, token) ||
+            PPTraceContains(pptraceExport, token) ||
+            PPTraceContains(funcName, token)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool PPTraceShouldEnterPPSinkContext(const std::string &pptraceModule,
+    const std::string &pptraceRequest,
+    const std::string &pptraceSo,
+    const std::string &pptraceExport,
+    const std::string &funcName)
+{
+    return !PPTraceIsIgnoredNativeModule(pptraceModule, pptraceRequest, pptraceSo, pptraceExport, funcName);
+}
+
+static bool PPTraceHasPPTaintMarker(const std::string &value)
+{
+    return value.find("__GHUNTER_PP_TAINT__") != std::string::npos;
+}
+
+constexpr uint32_t PPTrace_PP_NUMERIC_TAINT_BASE = 0xABC000;
+constexpr uint32_t PPTrace_PP_NUMERIC_TAINT_LIMIT = 0xABC0FF;
+
+static int PPTraceHexDigitValue(char ch)
+{
+    if (ch >= '0' && ch <= '9') {
+        return ch - '0';
+    }
+    if (ch >= 'a' && ch <= 'f') {
+        return ch - 'a' + 10;
+    }
+    if (ch >= 'A' && ch <= 'F') {
+        return ch - 'A' + 10;
+    }
+    return -1;
+}
+
+static bool PPTraceIsPPNumericTaintUInt(uint64_t value)
+{
+    return value >= PPTrace_PP_NUMERIC_TAINT_BASE && value <= PPTrace_PP_NUMERIC_TAINT_LIMIT;
+}
+
+static bool PPTraceParsePPNumericTaintString(const std::string &value, uint64_t &out)
+{
+    if (value.empty()) {
+        return false;
+    }
+
+    size_t index = 0;
+    uint32_t base = 10;
+    if (value.size() > 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X')) {
+        index = 2;
+        base = 16;
+    }
+    if (index >= value.size()) {
+        return false;
+    }
+
+    uint64_t parsed = 0;
+    for (; index < value.size(); index++) {
+        int digit = (base == 16) ? PPTraceHexDigitValue(value[index]) :
+            ((value[index] >= '0' && value[index] <= '9') ? value[index] - '0' : -1);
+        if (digit < 0 || static_cast<uint32_t>(digit) >= base) {
+            return false;
+        }
+        parsed = parsed * base + static_cast<uint64_t>(digit);
+        if (parsed > PPTrace_PP_NUMERIC_TAINT_LIMIT) {
+            return false;
+        }
+    }
+
+    out = parsed;
+    return PPTraceIsPPNumericTaintUInt(parsed);
+}
+
+static bool PPTraceIsPPNumericTaintNumber(double value) {
+    if (value < static_cast<double>(PPTrace_PP_NUMERIC_TAINT_BASE) ||
+        value > static_cast<double>(PPTrace_PP_NUMERIC_TAINT_LIMIT)) {
+        return false;
+    }
+    uint64_t intValue = static_cast<uint64_t>(value);
+    return static_cast<double>(intValue) == value;
+}
+
+static std::string PPTraceTruncateForSinkLog(const std::string &value)
+{
+    if (value.size() <= PPTrace_MAX_PPSINK_LOG_VALUE) {
+        return value;
+    }
+    return value.substr(0, PPTrace_MAX_PPSINK_LOG_VALUE) + "...";
+}
+
+static std::string PPTraceSanitizeForOneLine(std::string value)
+{
+    for (char &ch : value) {
+        if (ch == '\n' || ch == '\r' || ch == '\t') {
+            ch = ' ';
+        }
+    }
+    return value;
+}
+
+static std::string PPTraceBuildJsStackForPPSink(EcmaVM *vm)
+{
+    if (vm == nullptr) {
+        return "";
+    }
+
+    std::vector<JsFrameInfo> frames;
+    if (!DFXJSNApi::BuildJsStackInfoList(vm, gettid(), frames) || frames.empty()) {
+        return "";
+    }
+
+    std::stringstream ss;
+    size_t count = std::min<size_t>(frames.size(), PPTrace_MAX_PPSINK_JS_STACK_FRAMES);
+    for (size_t i = 0; i < count; i++) {
+        const auto &frame = frames[i];
+        if (i > 0) {
+            ss << ";";
+        }
+        ss << i << ":" << PPTraceSanitizeForOneLine(frame.functionName)
+           << "@" << PPTraceSanitizeForOneLine(frame.fileName)
+           << ":" << PPTraceSanitizeForOneLine(frame.pos);
+        if (!frame.packageName.empty()) {
+            ss << "#" << PPTraceSanitizeForOneLine(frame.packageName);
+        }
+    }
+    if (frames.size() > count) {
+        ss << ";...";
+    }
+    return ss.str();
+}
+
+static std::string PPTraceReadStringProperty(EcmaVM *vm,
+    panda::Local<panda::ObjectRef> obj,
+    const char *name)
+{
+    if (obj.IsEmpty()) {
+        return "";
+    }
+
+    panda::Local<panda::StringRef> key = panda::StringRef::NewFromUtf8(vm, name);
+    panda::PropertyAttribute attr;
+    if (!obj->GetOwnProperty(vm, key, attr) || !attr.HasValue()) {
+        return "";
+    }
+
+    panda::Local<panda::JSValueRef> value = attr.GetValue(vm);
+    if (value.IsEmpty() || !value->IsString(vm)) {
+        return "";
+    }
+    return panda::Local<panda::StringRef>(value)->ToString(vm);
+}
+
+static bool PPTraceGetDirectArgTaintReason(EcmaVM *vm,
+    panda::Local<panda::JSValueRef> value,
+    std::string &reason)
+{
+    if (value.IsEmpty()) {
+        return false;
+    }
+    // HILOG_INFO("[pptrace] checking direct arg for taint");
+    if (value->IsString(vm)) {
+        std::string raw = panda::Local<panda::StringRef>(value)->ToString(vm);
+        if (PPTraceHasPPTaintMarker(raw)) {
+            reason = "tainted-string value=" + PPTraceTruncateForSinkLog(raw);
+            return true;
+        }
+        // Keep numeric-string recognition aligned with Ark property-read sinks.
+        uint64_t numericTaint = 0;
+        if (PPTraceParsePPNumericTaintString(raw, numericTaint)) {
+            reason = "tainted-numeric-string value=[" + PPTraceTruncateForSinkLog(raw) + "]";
+            return true;
+        }
+        return false;
+    }
+    if (value->IsNumber()) {
+        double raw = value->ToNumber(vm)->Value();
+        if (PPTraceIsPPNumericTaintNumber(raw)) {
+            reason = "tainted-numeric-value value=" + std::to_string(static_cast<int64_t>(raw));
+            return true;
+        }
+        return false;
+    }
+
+    if (!value->IsObject(vm)) {
+        return false;
+    }
+
+    panda::Local<panda::ObjectRef> obj(value);
+    std::string id = PPTraceReadStringProperty(vm, obj, "__pp_taint_id__");
+    if (id.empty() || !PPTraceHasPPTaintMarker(id)) {
+        return false;
+    }
+
+    reason = "tainted-meta id=" + PPTraceTruncateForSinkLog(id);
+    std::string taintKey = PPTraceReadStringProperty(vm, obj, "__pp_taint_key__");
+    if (!taintKey.empty()) {
+        reason += " taintKey=[" + PPTraceTruncateForSinkLog(taintKey) + "]";
+    }
+    return true;
+}
+
+static void PPTraceLogDirectArgPPSinks(JsiRuntimeCallInfo *runtimeInfo,
+    const std::string &pptraceModule,
+    const std::string &pptraceRequest,
+    const std::string &pptraceSo,
+    const std::string &pptraceExport,
+    const std::string &funcName,
+    bool active)
+{
+    if (!active || runtimeInfo == nullptr) {
+        return;
+    }
+
+    EcmaVM *vm = runtimeInfo->GetVM();
+    std::string jsStack = PPTraceBuildJsStackForPPSink(vm);
+    uint32_t argc = runtimeInfo->GetArgsNumber();
+    uint32_t count = argc > PPTrace_MAX_PPSINK_ARGS ? PPTrace_MAX_PPSINK_ARGS : argc;
+    for (uint32_t i = 0; i < count; i++) {
+        std::string taintReason;
+        if (!PPTraceGetDirectArgTaintReason(vm, runtimeInfo->GetCallArgRef(i), taintReason)) {
+            continue;
+        }
+
+        HILOG_INFO("[pptrace][pp-sink] callbackFunction=%{public}s module=%{public}s "
+            "requestModule=%{public}s so=%{public}s export=%{public}s "
+            "argPath=arg[%{public}u] source=arg-self taintReason=%{public}s, jsStack=[%{public}s]",
+            funcName.empty() ? "<unknown>" : funcName.c_str(),
+            pptraceModule.empty() ? "<unknown>" : pptraceModule.c_str(),
+            pptraceRequest.empty() ? "<unknown>" : pptraceRequest.c_str(),
+            pptraceSo.empty() ? "<unknown>" : pptraceSo.c_str(),
+            pptraceExport.empty() ? "<unknown>" : pptraceExport.c_str(),
+            i,
+            taintReason.c_str(),
+            jsStack.c_str());
+    }
+}
+
+class PPTracePPSinkCallbackScope {
+public:
+    PPTracePPSinkCallbackScope(JsiRuntimeCallInfo *runtimeInfo,
+        const std::string &pptraceModule,
+        const std::string &pptraceRequest,
+        const std::string &pptraceSo,
+        const std::string &pptraceExport,
+        const std::string &funcName,
+        bool active)
+    {
+        if (!active || runtimeInfo == nullptr) {
+            return;
+        }
+
+        enter_ = PPTraceResolveEnterPPSinkContext();
+        leave_ = PPTraceResolveLeavePPSinkContext();
+        if (enter_ == nullptr || leave_ == nullptr) {
+            return;
+        }
+
+        uint32_t argc = runtimeInfo->GetArgsNumber();
+        uintptr_t argTags[PPTrace_MAX_PPSINK_ARGS] = {};
+        uint32_t argTagCount = argc > PPTrace_MAX_PPSINK_ARGS ? PPTrace_MAX_PPSINK_ARGS : argc;
+        for (uint32_t i = 0; i < argTagCount; i++) {
+            argTags[i] = PPTraceGetLocalRawData(runtimeInfo->GetCallArgRef(i));
+        }
+
+        enter_(pptraceModule.c_str(), pptraceRequest.c_str(), pptraceSo.c_str(),
+            pptraceExport.c_str(), funcName.c_str(), PPTrace_DEFAULT_PP_KEY,
+            argc, argTags, argTagCount);
+        armed_ = true;
+    }
+
+    ~PPTracePPSinkCallbackScope()
+    {
+        if (armed_ && leave_ != nullptr) {
+            leave_();
+        }
+    }
+
+private:
+    bool armed_ = false;
+    PPTraceEnterPPSinkContextFunc enter_ = nullptr;
+    PPTraceLeavePPSinkContextFunc leave_ = nullptr;
+};
