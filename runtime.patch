+static bool StartsWithAnyActsBundlePrefix(const char *bundleName)
+{
+    if (bundleName == nullptr || bundleName[0] == '\0') {
+        return false;
+    }
+
+    for (const auto *prefix : bundlePrefixWhitelist) {
+        const size_t prefixLen = std::strlen(prefix);
+        if (std::strncmp(bundleName, prefix, prefixLen) == 0) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static inline bool ShouldCutFastPath(JSThread *thread)
+{
+    if (thread == nullptr || thread->GetEcmaVM() == nullptr) {
+        return false;
+    }
+    if (PPTraceShouldCutFastPathForPPSinkContext()) {
+        return true;
+    }
+    auto bundleName = thread->GetEcmaVM()->GetBundleName();
+    if (StartsWithAnyActsBundlePrefix(bundleName.c_str())) {
+        return true;
+    }
+    // A freshly forked Ability can execute its earliest callbacks before the
+    // VM publishes the bundle name.  Fall back to the runtime phase predicate
+    // only for that empty-name bootstrap window.
+    return bundleName.empty() && PPTraceShouldCutFastPathForInstrumentation(thread);
+}
