+static void PPTraceMaybeLogUndefinedPropContext(JSThread *thread, ObjectOperator *op, const std::string &type)
+{
+    if (!PPTracePPPhaseIsUndef() || !(op->IsOnPrototype() && !op->IsFound())) {
+        return;
+    }
+    std::string typeflag = (type == "GET") ? "GET" : "HAS";
+    std::string key = PPTraceGetPropertyKeyString(thread, op);
+    if (key.empty() || PPTraceIsIgnoredPPProperty(key)) {
+        return;
+    }
+
+    // Snapshot only: never enumerate properties or invoke JS conversion hooks.
+    // This raw tag is not a stable object ID across moving GC or process lifetimes.
+    auto receiver = op->GetReceiver();
+    std::string receiverType = PPTraceValueTypeString(thread, receiver.GetTaggedValue());
+    std::ostringstream tag;
+    tag << "0x" << std::hex << receiver.GetTaggedValue().GetRawData();
+    const std::string originFields = PPTracePropertyOriginFields(thread);
+    auto frames = JsStackInfo::BuildJsStackInfo(thread, true);
+    if (frames.empty()) {
+        LOG_FULL(INFO) << "[pptrace][prop-context-" << typeflag << "]"
+            << " key=[" << PPTraceSanitizeForOneLine(key) << "]"
+            << " receiverType=" << receiverType << " receiverTag=" << tag.str()
+            << " receiverExpr=<offline> no js stack info" << originFields;
+        return;
+    }
+    auto frame = frames.front();
+    const std::string rawFile = frame.fileName;
+    const std::string rawPos = frame.pos;
+    // Debug positions can be '?'. Parse without stoi exceptions or overflow.
+    auto parsePosition = [](const std::string &text, int &value) {
+        if (text.empty()) {
+            return false;
+        }
+        value = 0;
+        for (char ch : text) {
+            if (ch < '0' || ch > '9' || value > (INT32_MAX - (ch - '0')) / 10) {
+                return false;
+            }
+            value = value * 10 + (ch - '0');
+        }
+        return value > 0;
+    };
+    size_t sep = frame.pos.find(':');
+    int line = 0;
+    int column = 0;
+    if (sep != std::string::npos && parsePosition(frame.pos.substr(0, sep), line) &&
+        parsePosition(frame.pos.substr(sep + 1), column)) {
+        auto sourceMapCb = thread->GetEcmaVM()->GetSourceMapTranslateCallback();
+        if (sourceMapCb != nullptr && !frame.fileName.empty()) {
+            sourceMapCb(frame.fileName, line, column, frame.packageName);
+            if (line > 0 && column > 0) {
+                frame.pos = std::to_string(line) + ":" + std::to_string(column);
+            } else {
+                frame.pos = "?";
+            }
+        }
+    }
+    // Keep test frames here: native requests can have only a test JS caller.
+    LOG_FULL(INFO) << "[pptrace][prop-context-" << typeflag << "]"
+        << " key=[" << PPTraceSanitizeForOneLine(key) << "]"
+        << " function=" << PPTraceSanitizeForOneLine(frame.functionName)
+        << " file=" << PPTraceSanitizeForOneLine(frame.fileName)
+        << " pos=" << frame.pos
+        << " package=" << PPTraceSanitizeForOneLine(frame.packageName)
+        << " receiverType=" << receiverType << " receiverTag=" << tag.str()
+        << " receiverExpr=<offline>"
+        << " rawFile=" << PPTraceSanitizeForOneLine(rawFile) << " rawPos=" << rawPos
+        << originFields;
+}
+
+static void PPTraceMaybeLogPPSinkRead(JSThread *thread, ObjectOperator *op, JSTaggedValue value)
+{
+    if (!PPTracePPPhaseIsTaint()) {
+        return;
+    }
+
+    // 1. check if in native callback context, and prop is Found
+    auto &ctx = g_pptracePPSinkContext;
+    if (!ctx.active || PPTraceIsIgnoredPPSinkContext(ctx) || !op->IsFound()) {
+        return;
+    }
+
+    // filter out some common properties
+    std::string key = PPTraceGetPropertyKeyString(thread, op);
+    if (key.empty() || PPTraceIsIgnoredPPProperty(key)) {
+        return;
+    }
+
+    auto receiver = op->GetReceiver();
+    uintptr_t receiverTag = static_cast<uintptr_t>(receiver.GetTaggedValue().GetRawData());
+    std::string argPath = PPTraceBuildArgPath(ctx, receiverTag, key);
+    if (value.IsECMAObject() || value.IsJSProxy()) {
+        uintptr_t valueTag = static_cast<uintptr_t>(value.GetRawData());
+        PPTraceRememberPath(ctx, valueTag, argPath);
+    }
+
+    // 2. check if the value read from a native callback argument is tainted.
+    std::string taintReason;
+    if (!PPTraceIsPPTaintedValue(thread, value, "", taintReason)) {
+        return;
+    }
+
+    auto frames = JsStackInfo::BuildJsStackInfo(thread, true);
+    std::string jsStack = PPTraceFormatJsStackForPPSink(frames);
+    std::string jsFunction;
+    std::string jsFile;
+    std::string jsPos;
+    std::string jsPackage;
+    if (!frames.empty()) {
+        auto frame = frames.front();
+        size_t sep = frame.pos.find(':');
+        if (sep != std::string::npos) {
+            auto sourceMapCb = thread->GetEcmaVM()->GetSourceMapTranslateCallback();
+            if (sourceMapCb != nullptr && !frame.fileName.empty()) {
+                int line = std::stoi(frame.pos.substr(0, sep));
+                int column = std::stoi(frame.pos.substr(sep + 1));
+                sourceMapCb(frame.fileName, line, column, frame.packageName);
+            }
+        }
+        jsFunction = frame.functionName;
+        jsFile = frame.fileName;
+        jsPos = frame.pos;
+        jsPackage = frame.packageName;
+    }
+
+    LOG_FULL(INFO) << "[pptrace][pp-sink]"
+        << " callbackFunction=" << PPTraceOrUnknownLocal(ctx.functionName)
+        << " module=" << PPTraceOrUnknownLocal(ctx.nativeModule)
+        << " requestModule=" << PPTraceOrUnknownLocal(ctx.requestModule)
+        << " so=" << PPTraceOrUnknownLocal(ctx.soPath)
+        << " export=" << PPTraceOrUnknownLocal(ctx.exportPath)
+        << " argPath=" << argPath
+        << " key=[" << key << "]"
+        << " source=" << (op->IsOnPrototype() ? "prototype" : "own")
+        << " taintReason=" << taintReason
+        << ", caller info: jsFunction=" << jsFunction
+        << " file=" << jsFile
+        << " pos=" << jsPos
+        << " package=" << jsPackage
+        << ", jsStack=" << jsStack;
+}
+
+extern "C" PPTrace_PUBLIC_HOOK void PPTraceEnterPPSinkContext(const char *nativeModule,
+    const char *requestModule,
+    const char *soPath,
+    const char *exportPath,
+    const char *functionName,
+    const char *ppKey,
+    uint32_t argc,
+    const uintptr_t *argTags,
+    uint32_t argTagCount)
+{
+    if (g_pptracePPSinkContextDepth < PPTrace_MAX_PPSINK_STACK) {
+        g_pptracePPSinkContextStack[g_pptracePPSinkContextDepth++] = g_pptracePPSinkContext;
+    }
+
+    g_pptracePPSinkContext = {};
+    g_pptracePPSinkContext.active = true;
+    g_pptracePPSinkContext.nativeModule = nativeModule == nullptr ? "" : nativeModule;
+    g_pptracePPSinkContext.requestModule = requestModule == nullptr ? "" : requestModule;
+    g_pptracePPSinkContext.soPath = soPath == nullptr ? "" : soPath;
+    g_pptracePPSinkContext.exportPath = exportPath == nullptr ? "" : exportPath;
+    g_pptracePPSinkContext.functionName = functionName == nullptr ? "" : functionName;
+    g_pptracePPSinkContext.ppKey = ppKey == nullptr ? "" : ppKey;
+    g_pptracePPSinkContext.argc = argc;
+
+    uint32_t count = std::min(argTagCount, PPTrace_MAX_PPSINK_ARGS);
+    for (uint32_t i = 0; i < count; i++) {
+        g_pptracePPSinkContext.argTags[i] = argTags == nullptr ? 0 : argTags[i];
+        PPTraceRememberPath(g_pptracePPSinkContext, g_pptracePPSinkContext.argTags[i],
+            "arg[" + std::to_string(i) + "]");
+    }
+
+    if (PPTracePPPhaseIsDebug()) {
+        LOG_FULL(INFO) << "[pptrace][pp-sink-debug] enter"
+            << " callbackFunction=" << PPTraceOrUnknownLocal(g_pptracePPSinkContext.functionName)
+            << " module=" << PPTraceOrUnknownLocal(g_pptracePPSinkContext.nativeModule)
+            << " requestModule=" << PPTraceOrUnknownLocal(g_pptracePPSinkContext.requestModule)
+            << " argc=" << argc;
+    }
+}
+
+extern "C" PPTrace_PUBLIC_HOOK bool PPTraceIsPPSinkContextActiveForFastPath()
+{
+    return g_pptracePPSinkContext.active;
+}
+
+extern "C" PPTrace_PUBLIC_HOOK void PPTraceLeavePPSinkContext()
+{
+    if (g_pptracePPSinkContextDepth > 0) {
+        g_pptracePPSinkContext = g_pptracePPSinkContextStack[--g_pptracePPSinkContextDepth];
+        return;
+    }
+    g_pptracePPSinkContext = {};
+}
