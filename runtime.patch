+namespace {
+bool IsPPTracePropertyInstrumentationEnabled()
+{
+    constexpr uint32_t phaseValueLength = 32;
+    char phase[phaseValueLength] = "off";
+    using GetParameterFunc = int (*)(const char *, const char *, char *, uint32_t);
+    static auto getParameter = reinterpret_cast<GetParameterFunc>(dlsym(RTLD_DEFAULT, "GetParameter"));
+    if (getParameter == nullptr) {
+        return false;
+    }
+    getParameter("persist.pptrace.pp.phase", "off", phase, phaseValueLength);
+    return phase[0] != '\0' && std::strcmp(phase, "off") != 0 &&
+        std::strcmp(phase, "0") != 0 && std::strcmp(phase, "false") != 0;
+}
