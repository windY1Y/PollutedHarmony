+    PPTracePathEntry paths[PPTrace_MAX_PPSINK_PATHS] = {};
+    uint32_t pathCount = 0;
+};
+
+thread_local PPTracePPSinkContext g_pptracePPSinkContext;
+thread_local PPTracePPSinkContext g_pptracePPSinkContextStack[PPTrace_MAX_PPSINK_STACK];
+thread_local uint32_t g_pptracePPSinkContextDepth = 0;
+
+enum class PPTracePPPhase {
+    UNKNOWN,
+    OFF,
+    UNDEF,
+    TYPE,
+    TAINT,
+    ALL,
+    DEBUG
+};
+
+static PPTracePPPhase PPTraceParsePPPhase(const std::string &value)
+{
+    if (value == "undef" || value == "undefined" || value == "undefined_props") {
+        return PPTracePPPhase::UNDEF;
+    }
+    if (value == "type" || value == "types" || value == "type_collection") {
+        return PPTracePPPhase::TYPE;
+    }
+    if (value == "taint" || value == "sink" || value == "pp-sink") {
+        return PPTracePPPhase::TAINT;
+    }
+    if (value == "all") {
+        return PPTracePPPhase::ALL;
+    }
+    if (value == "debug") {
+        return PPTracePPPhase::DEBUG;
+    }
+    return PPTracePPPhase::OFF;
+}
+
+static PPTracePPPhase PPTraceReadPPPhase()
+{
+    constexpr uint32_t PPTrace_PP_PHASE_VALUE_LEN = 32;
+    char value[PPTrace_PP_PHASE_VALUE_LEN] = "off";
+    using PPTraceGetParameterFunc = int (*)(const char *key, const char *def, char *value, uint32_t len);
+    static auto getParameter = reinterpret_cast<PPTraceGetParameterFunc>(dlsym(RTLD_DEFAULT, "GetParameter"));
+    if (getParameter != nullptr) {
+        getParameter("persist.pptrace.pp.phase", "off", value, PPTrace_PP_PHASE_VALUE_LEN);
+    }
+    return PPTraceParsePPPhase(value);
+}
+
+static PPTracePPPhase PPTraceGetPPPhase()
+{
+    constexpr uint32_t PPTrace_PP_PHASE_REFRESH_MASK = 0x0FFF;
+    thread_local PPTracePPPhase cachedPhase = PPTracePPPhase::UNKNOWN;
+    thread_local uint32_t refreshCounter = 0;
+    // App processes are forked from appspawn.  A thread-local phase cache is
+    // copied across fork, so without a PID guard a newly launched test can
+    // inherit the parent's stale "off" phase and finish before the periodic
+    // refresh.  Refresh immediately in the child to make a phase set before
+    // `aa start` effective from its first observed property operation.
+    thread_local pid_t cachedPid = 0;
+    pid_t currentPid = getpid();
+
+    if (cachedPhase == PPTracePPPhase::UNKNOWN || cachedPid != currentPid ||
+        ((++refreshCounter) & PPTrace_PP_PHASE_REFRESH_MASK) == 0) {
+        cachedPhase = PPTraceReadPPPhase();
+        cachedPid = currentPid;
+    }
+    return cachedPhase;
+}
+
+static bool PPTracePPPhaseIsUndef()
+{
+    auto phase = PPTraceGetPPPhase();
+    return phase == PPTracePPPhase::UNDEF || phase == PPTracePPPhase::ALL || phase == PPTracePPPhase::DEBUG;
+}
+
+static bool PPTracePPPhaseIsType()
+{
+    auto phase = PPTraceGetPPPhase();
+    return phase == PPTracePPPhase::TYPE || phase == PPTracePPPhase::ALL || phase == PPTracePPPhase::DEBUG;
+}
+
+static bool PPTracePPPhaseIsTaint()
+{
+    auto phase = PPTraceGetPPPhase();
+    return phase == PPTracePPPhase::TAINT || phase == PPTracePPPhase::ALL || phase == PPTracePPPhase::DEBUG;
+}
