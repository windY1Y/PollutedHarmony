+// Property-origin instrumentation. No JS calls, allocation, or property inspection.
+#ifndef ECMASCRIPT_NAPI_INCLUDE_PPTrace_PROPERTY_CONTEXT_H
+#define ECMASCRIPT_NAPI_INCLUDE_PPTrace_PROPERTY_CONTEXT_H
+
+struct PPTracePropertyContext {
+    const void *vm;
+    const char *origin;
+    const char *api;
+    const char *module;
+    const PPTracePropertyContext *previous;
+    mutable const void *entryFrame;
+};
+
+extern "C" __attribute__((visibility("default"))) const PPTracePropertyContext *
+PPTraceExchangePropertyContext(const PPTracePropertyContext *context, bool entering = false);
+
+// Stack-owned, thread-local scopes retain ancestry and the entry frame boundary.
+// A younger JS frame is reentry, not proof of a native-owned property access.
+class PPTracePropertyContextScope final {
+public:
+    PPTracePropertyContextScope(const void *vm, const char *origin, const char *api, const char *module = "-")
+        : context_ {vm, origin, api, module, nullptr, nullptr}
+    {
+        context_.previous = PPTraceExchangePropertyContext(&context_, true);
+    }
+    ~PPTracePropertyContextScope()
+    {
+        PPTraceExchangePropertyContext(context_.previous);
+    }
+    PPTracePropertyContextScope(const PPTracePropertyContextScope &) = delete;
+    PPTracePropertyContextScope &operator=(const PPTracePropertyContextScope &) = delete;
+private:
+    PPTracePropertyContext context_;
+};
+#endif
