+constexpr uint32_t PPTrace_MAX_PPSINK_ARGS = 8;
+constexpr const char *PPTrace_DEFAULT_PP_KEY = "*";
+constexpr uint32_t PPTrace_MAX_PPSINK_LOG_VALUE = 160;
+constexpr uint32_t PPTrace_MAX_PPSINK_JS_STACK_FRAMES = 32;
