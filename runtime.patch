+
+void PPTraceMaybeLogObservedSpecialGetProperty(JSThread *thread,
+                                          const JSHandle<JSTaggedValue> &obj,
+                                          const JSHandle<JSTaggedValue> &key,
+                                          bool found,
+                                          JSTaggedValue value,
+                                          const char *source)
+{
+    if (thread == nullptr || thread->GetEcmaVM() == nullptr) {
+        return;
+    }
+
+    bool typePhase = PPTracePPPhaseIsType();
+    bool taintPhase = PPTracePPPhaseIsTaint();
+    if (!typePhase && !taintPhase) {
+        return;
+    }
+
+    std::string keyText = PPTraceGetTaggedPropertyKeyString(thread, key.GetTaggedValue());
+    if (keyText.empty() || PPTraceIsIgnoredPPProperty(keyText)) {
+        return;
+    }
+    const char *sourceText = source == nullptr ? "special" : source;
+    const auto &ctx = g_pptracePPSinkContext;
+
+    if (typePhase) {
+        bool inScope = PPTraceShouldCutFastPathForInstrumentation(thread);
+        if (inScope && PPTraceShouldObservePropTypeKey(keyText)) {
+            const auto origin = PPTraceResolvePropertyOrigin(thread);
+            auto frames = JsStackInfo::BuildJsStackInfo(thread, true);
+            if (!PPTraceShouldSkipObservedFrame(frames, origin)) {
+                PPTraceTranslateTopFrameSourceMap(thread, frames);
+                std::string jsFunction;
+                std::string jsFile;
+                std::string jsPos;
+                std::string jsPackage;
+                if (!frames.empty()) {
+                    const auto &frame = frames.front();
+                    jsFunction = frame.functionName;
+                    jsFile = frame.fileName;
+                    jsPos = frame.pos;
+                    jsPackage = frame.packageName;
+                }
+
+                LOG_FULL(INFO) << "[pptrace][prop-type-GET]"
+                    << " key=[" << keyText << "]"
+                    << " found=" << (found ? "1" : "0")
+                    << " source=" << sourceText
+                    << " kind=special"
+                    << " valueType=" << PPTraceValueTypeString(thread, value)
+                    << " receiverType=" << PPTraceValueTypeString(thread, obj.GetTaggedValue())
+                    << " holderType=" << PPTraceValueTypeString(thread, obj.GetTaggedValue())
+                    << " inNative=" << (origin.inNative ? "1" : "0")
+                    << " inNativeContext=" << (ctx.active ? "1" : "0")
+                    << origin.fields
+                    << " callbackFunction=" << PPTraceOrUnknownLocal(ctx.functionName)
+                    << " module=" << PPTraceOrUnknownLocal(ctx.nativeModule)
+                    << " requestModule=" << PPTraceOrUnknownLocal(ctx.requestModule)
+                    << " function=" << jsFunction
+                    << " file=" << jsFile
+                    << " pos=" << jsPos
+                    << " package=" << jsPackage;
+            }
+        }
+    }
+
+    if (!taintPhase || !ctx.active || PPTraceIsIgnoredPPSinkContext(ctx) || !found) {
+        return;
+    }
+
+    uintptr_t receiverTag = static_cast<uintptr_t>(obj.GetTaggedValue().GetRawData());
+    std::string argPath = PPTraceBuildArgPath(g_pptracePPSinkContext, receiverTag, keyText);
+    if (value.IsECMAObject() || value.IsJSProxy()) {
+        uintptr_t valueTag = static_cast<uintptr_t>(value.GetRawData());
+        PPTraceRememberPath(g_pptracePPSinkContext, valueTag, argPath);
+    }
+
+    std::string taintReason;
+    if (!PPTraceIsPPTaintedValue(thread, value, "", taintReason)) {
+        return;
+    }
+
+    auto frames = JsStackInfo::BuildJsStackInfo(thread, true);
+    std::string jsStack = PPTraceFormatJsStackForPPSink(frames);
+    std::string jsFunction;
+    std::string jsFile;
+    std::string jsPos;
+    std::string jsPackage;
+    if (!frames.empty()) {
+        PPTraceTranslateTopFrameSourceMap(thread, frames);
+        const auto &frame = frames.front();
+        jsFunction = frame.functionName;
+        jsFile = frame.fileName;
+        jsPos = frame.pos;
+        jsPackage = frame.packageName;
+    }
+
+    LOG_FULL(INFO) << "[pptrace][pp-sink]"
+        << " callbackFunction=" << PPTraceOrUnknownLocal(ctx.functionName)
+        << " module=" << PPTraceOrUnknownLocal(ctx.nativeModule)
+        << " requestModule=" << PPTraceOrUnknownLocal(ctx.requestModule)
+        << " so=" << PPTraceOrUnknownLocal(ctx.soPath)
+        << " export=" << PPTraceOrUnknownLocal(ctx.exportPath)
+        << " argPath=" << argPath
+        << " key=[" << keyText << "]"
+        << " source=" << sourceText
+        << " taintReason=" << taintReason
+        << ", caller info: jsFunction=" << jsFunction
+        << " file=" << jsFile
+        << " pos=" << jsPos
+        << " package=" << jsPackage
+        << ", jsStack=" << jsStack;
+}
