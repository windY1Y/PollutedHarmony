+            g_pptraceNativeModuleContext.valid = true;
+            g_pptraceNativeModuleContext.requestModule = requestName;
+            g_pptraceNativeModuleContext.nativeModule = nativeModule.empty() ? requestName : nativeModule;
+            g_pptraceNativeModuleContext.soPath = soPath;
+        }
+    }
+
+    ~PPTraceNativeModuleInfoScope()
+    {
+        g_pptraceNativeModuleContext = old_;
+    }
+
+private:
+    PPTraceNativeModuleContext old_;
+};
+
+void PPTraceFillNapiFunctionInfo(napi_env env, NapiFunctionInfo *info, const char *exportPath)
+{
+    if (info == nullptr) {
+        return;
+    }
+
+    if (g_pptraceNativeModuleContext.valid) {
+        info->pptraceRequestModule = g_pptraceNativeModuleContext.requestModule;
+        info->pptraceNativeModule = g_pptraceNativeModuleContext.nativeModule;
+        info->pptraceSoPath = g_pptraceNativeModuleContext.soPath;
+    } else if (!ArkNativeEngine::tempModuleName_.empty()) {
+        info->pptraceRequestModule = ArkNativeEngine::tempModuleName_;
+        info->pptraceNativeModule = ArkNativeEngine::tempModuleName_;
+    }
+
+    if (exportPath != nullptr) {
+        std::string realExportPath = exportPath;
+        if (!g_pptraceFunctionOwnerPath.empty() &&
+            realExportPath.rfind(g_pptraceFunctionOwnerPath, 0) != 0) {
+            realExportPath = g_pptraceFunctionOwnerPath + realExportPath;
+        }
+        info->pptraceExportPath = realExportPath;
+    }
+}
+
+constexpr uint32_t PPTrace_MAX_SINK_OBJECT_DEPTH = 4;
+constexpr uint32_t PPTrace_MAX_SINK_OBJECT_KEYS = 256;
+
+static std::string PPTraceToStdStringForTag(EcmaVM *vm, panda::Local<panda::JSValueRef> value)
+{
+    if (value.IsEmpty()) {
+        return "";
+    }
+    if (value->IsString(vm)) {
+        return panda::Local<panda::StringRef>(value)->ToString(vm);
+    }
+    if (value->IsNumber()) {
+        return std::to_string(static_cast<int64_t>(value->ToNumber(vm)->Value()));
+    }
+    return "";
+}
+
+static void PPTraceFillNapiFunctionInfoByValue(NapiFunctionInfo *info,
+    const std::string &requestModule,
+    const std::string &nativeModule,
+    const std::string &soPath,
+    const std::string &exportPath)
+{
+    if (info == nullptr) {
+        return;
+    }
+
+    if (info->pptraceRequestModule.empty() && !requestModule.empty()) {
+        info->pptraceRequestModule = requestModule;
+    }
+    if (info->pptraceNativeModule.empty() && !nativeModule.empty()) {
+        info->pptraceNativeModule = nativeModule;
+    }
+    if (info->pptraceSoPath.empty() && !soPath.empty()) {
+        info->pptraceSoPath = soPath;
+    }
+    if (info->pptraceExportPath.empty() && !exportPath.empty()) {
+        info->pptraceExportPath = exportPath;
+    }
+}
+
+static void PPTraceTagNativeValueTree(EcmaVM *vm,
+    panda::Local<panda::JSValueRef> value,
+    const std::string &requestModule,
+    const std::string &nativeModule,
+    const std::string &soPath,
+    const std::string &path,
+    uint32_t depth)
+{
+    if (value.IsEmpty()) {
+        return;
+    }
+
+    if (value->IsFunction(vm)) {
+        panda::Local<panda::FunctionRef> fn(value);
+        auto info = reinterpret_cast<NapiFunctionInfo*>(fn->GetData(vm));
+        PPTraceFillNapiFunctionInfoByValue(info, requestModule, nativeModule, soPath, path);
+    }
+
+    if (!value->IsObject(vm)) {
+        return;
+    }
+
+    if (depth >= PPTrace_MAX_SINK_OBJECT_DEPTH) {
+        return;
+    }
+
+    panda::Local<panda::ObjectRef> obj(value);
+    panda::Local<panda::ArrayRef> names = obj->GetOwnPropertyNames(vm);
+    if (names.IsEmpty()) {
+        return;
+    }
+
+    uint32_t len = names->Length(vm);
+    if (len > PPTrace_MAX_SINK_OBJECT_KEYS) {
+        len = PPTrace_MAX_SINK_OBJECT_KEYS;
+    }
+
+    for (uint32_t i = 0; i < len; i++) {
+        panda::Local<panda::JSValueRef> key = panda::ArrayRef::GetValueAt(vm, names, i);
+        std::string keyStr = PPTraceToStdStringForTag(vm, key);
+        if (keyStr.empty()) {
+            continue;
+        }
+
+        panda::PropertyAttribute attr;
+        if (!obj->GetOwnProperty(vm, key, attr) || !attr.HasValue()) {
+            continue;
+        }
+
+        panda::Local<panda::JSValueRef> child = attr.GetValue(vm);
+        if (child.IsEmpty()) {
+            continue;
+        }
+
+        std::string childPath = path.empty() ? keyStr : path + "." + keyStr;
+        PPTraceTagNativeValueTree(vm, child, requestModule, nativeModule, soPath, childPath, depth + 1);
+    }
+}
+
+static void PPTraceTagNativeValueTreeByModule(EcmaVM *vm,
+    panda::Local<panda::JSValueRef> value,
+    const std::string &requestModule,
+    NativeModule *module)
+{
+    std::string nativeModule = module && module->name ? module->name : requestModule;
+    std::string soPath = module && module->systemFilePath ? module->systemFilePath : "";
+    PPTraceTagNativeValueTree(vm, value, requestModule, nativeModule, soPath, "", 0);
+}
