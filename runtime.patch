+constexpr uint32_t PPTrace_PP_NUMERIC_TAINT_BASE = 0xABC000;
+constexpr uint32_t PPTrace_PP_NUMERIC_TAINT_LIMIT = 0xABC0FF;
+
+static bool PPTraceHasPPTaintMarker(const std::string &value)
+{
+    return value.find("__GHUNTER_PP_TAINT__") != std::string::npos;
+}
+
+static int PPTraceHexDigitValue(char ch)
+{
+    if (ch >= '0' && ch <= '9') {
+        return ch - '0';
+    }
+    if (ch >= 'a' && ch <= 'f') {
+        return ch - 'a' + 10;
+    }
+    if (ch >= 'A' && ch <= 'F') {
+        return ch - 'A' + 10;
+    }
+    return -1;
+}
+
+static bool PPTraceIsPPNumericTaintUInt(uint64_t value)
+{
+    return value >= PPTrace_PP_NUMERIC_TAINT_BASE && value <= PPTrace_PP_NUMERIC_TAINT_LIMIT;
+}
+
+static bool PPTraceParsePPNumericTaintString(const std::string &value, uint64_t &out)
+{
+    if (value.empty()) {
+        return false;
+    }
+
+    size_t index = 0;
+    uint32_t base = 10;
+    if (value.size() > 2 && value[0] == '0' && (value[1] == 'x' || value[1] == 'X')) {
+        index = 2;
+        base = 16;
+    }
+    if (index >= value.size()) {
+        return false;
+    }
+
+    uint64_t parsed = 0;
+    for (; index < value.size(); index++) {
+        int digit = (base == 16) ? PPTraceHexDigitValue(value[index]) :
+            ((value[index] >= '0' && value[index] <= '9') ? value[index] - '0' : -1);
+        if (digit < 0 || static_cast<uint32_t>(digit) >= base) {
+            return false;
+        }
+        parsed = parsed * base + static_cast<uint64_t>(digit);
+        if (parsed > PPTrace_PP_NUMERIC_TAINT_LIMIT) {
+            return false;
+        }
+    }
+
+    out = parsed;
+    return PPTraceIsPPNumericTaintUInt(parsed);
+}
+
+static bool PPTraceIsPPNumericTaintNumber(JSTaggedValue value)
+{
+    if (value.IsInt()) {
+        int raw = value.GetInt();
+        return raw >= 0 && PPTraceIsPPNumericTaintUInt(static_cast<uint64_t>(raw));
+    }
+    if (value.IsSpecial() || !value.IsDouble()) {
+        return false;
+    }
+
+    double raw = value.GetDouble();
+    if (raw < static_cast<double>(PPTrace_PP_NUMERIC_TAINT_BASE) ||
+        raw > static_cast<double>(PPTrace_PP_NUMERIC_TAINT_LIMIT)) {
+        return false;
+    }
+    uint64_t intValue = static_cast<uint64_t>(raw);
+    return static_cast<double>(intValue) == raw && PPTraceIsPPNumericTaintUInt(intValue);
+}
+
+static bool PPTraceReadOwnDataStringProperty(JSThread *thread,
+    JSTaggedValue objectValue,
+    const char *name,
+    std::string &out)
+{
+    if (objectValue.IsJSProxy()) {
+        objectValue = JSProxy::Cast(objectValue.GetTaggedObject())->GetTarget(thread);
+    }
+    if (!objectValue.IsECMAObject() || objectValue.IsJSProxy()) {
+        return false;
+    }
+
+    auto factory = thread->GetEcmaVM()->GetFactory();
+    JSHandle<JSTaggedValue> obj(thread, objectValue);
+    JSHandle<JSTaggedValue> key(thread, factory->NewFromUtf8(name).GetTaggedValue());
+    ObjectOperator ownOp(thread, obj, key, OperatorType::OWN);
+    if (!ownOp.IsFound() || ownOp.IsAccessorDescriptor()) {
+        return false;
+    }
+
+    // JSTaggedValue value = JSObject::ShouldGetValueFromBox(&ownOp);
+    JSTaggedValue value = ownOp.GetValue();
+    if (value.IsPropertyBox()) {
+        value = PropertyBox::Cast(value.GetTaggedObject())->GetValue(thread);
+    }
+
+    if (!value.IsString()) {
+        return false;
+    }
+    out = EcmaStringAccessor(value).ToStdString(thread);
+    return true;
+}
+
+static bool PPTraceIsPPTaintedValue(JSThread *thread,
+    JSTaggedValue value,
+    const std::string &expectedKey,
+    std::string &reason)
+{
+    // LOG_FULL(INFO) << "[pptrace][pp-sink-debug] checking taint value...";
+    if (value.IsString()) {
+        std::string raw = EcmaStringAccessor(value).ToStdString(thread);
+        if (PPTraceHasPPTaintMarker(raw)) {
+            reason = "tainted-string";
+            return true;
+        }
+        uint64_t numericTaint = 0;
+        if (PPTraceParsePPNumericTaintString(raw, numericTaint)) {
+            reason = "tainted-numeric-string value=[" + raw + "]";
+            return true;
+        }
+        if (PPTracePPPhaseIsDebug()) {
+            LOG_FULL(INFO) << "[pptrace][pp-sink-debug] string value is not tainted: " << raw;
+        }
+        return false;
+    }
+
+    if (value.IsInt() || (!value.IsSpecial() && value.IsDouble())) {
+        if (PPTraceIsPPNumericTaintNumber(value)) {
+            reason = "tainted-numeric-value";
+            return true;
+        }
+        if (PPTracePPPhaseIsDebug()) {
+            LOG_FULL(INFO) << "[pptrace][pp-sink-debug] number value is not tainted.";
+        }
+        return false;
+    }
+
+    if (!value.IsECMAObject() && !value.IsJSProxy()) {
+        if (PPTracePPPhaseIsDebug()) {
+            LOG_FULL(INFO) << "[pptrace][pp-sink-debug] value is not object or proxy, not tainted.";
+        }
+        return false;
+    }
+
+    std::string id;
+    if (!PPTraceReadOwnDataStringProperty(thread, value, "__pp_taint_id__", id) ||
+        !PPTraceHasPPTaintMarker(id)) {
+        if (PPTracePPPhaseIsDebug()) {
+            LOG_FULL(INFO) << "[pptrace][pp-sink-debug] obj/proxy value is not tainted: " << id;
+        }
+        return false;
+    }
+
+    std::string taintKey;
+    if (PPTraceReadOwnDataStringProperty(thread, value, "__pp_taint_key__", taintKey) &&
+        !expectedKey.empty() && expectedKey != "*" && !taintKey.empty() && taintKey != expectedKey) {
+        return false;
+    }
+
+    reason = value.IsJSProxy() ? "tainted-proxy-meta" : "tainted-meta";
+    if (!taintKey.empty()) {
+        reason += " taintKey=[" + taintKey + "]";
+    }
+    return true;
+}
